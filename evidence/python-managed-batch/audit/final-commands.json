[
  {
    "name": "focused-final",
    "cwd": "<implementation>",
    "command": [
      "python3",
      "<test-cache>",
      "<implementation>/.venv/bin/python",
      "-m",
      "pytest",
      "-p",
      "no:cacheprovider",
      "--import-mode=importlib",
      "-q",
      "python/x402/tests/unit/mechanisms/evm/batch_settlement/server/test_managed.py",
      "python/x402/tests/unit/mechanisms/evm/batch_settlement/server/test_managed_recovery.py",
      "python/x402/tests/unit/mechanisms/evm/batch_settlement/client/test_managed_salt.py",
      "python/x402/tests/unit/mechanisms/evm/batch_settlement/test_types.py"
    ],
    "env": {
      "PYTHONPATH": "<implementation>/python",
      "PYTHONDONTWRITEBYTECODE": "1",
      "RUFF_NUM_THREADS": "2",
      "RAYON_NUM_THREADS": "2"
    },
    "exit": 0
  },
  {
    "name": "broad-final",
    "cwd": "<implementation>",
    "command": [
      "python3",
      "<test-cache>",
      "<implementation>/.venv/bin/python",
      "-m",
      "pytest",
      "-p",
      "no:cacheprovider",
      "--import-mode=importlib",
      "-q",
      "python/x402/tests/unit",
      "--ignore=python/x402/tests/unit/mechanisms/svm",
      "--ignore=python/x402/tests/unit/mechanisms/tvm"
    ],
    "env": {
      "PYTHONPATH": "<implementation>/python",
      "PYTHONDONTWRITEBYTECODE": "1",
      "RUFF_NUM_THREADS": "2",
      "RAYON_NUM_THREADS": "2"
    },
    "exit": 1
  },
  {
    "name": "ruff-final",
    "cwd": "<implementation>",
    "command": [
      "python3",
      "<test-cache>",
      "<validation>/bin/ruff",
