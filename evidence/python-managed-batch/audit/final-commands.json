      "python/x402/mechanisms/evm/batch_settlement/client/channel.py",
      "python/x402/mechanisms/evm/batch_settlement/errors.py",
      "python/x402/mechanisms/evm/batch_settlement/server/channel_manager.py",
      "python/x402/mechanisms/evm/batch_settlement/server/channel_manager_sync.py",
      "python/x402/mechanisms/evm/batch_settlement/server/managed.py",
      "python/x402/mechanisms/evm/batch_settlement/server/scheme.py",
      "python/x402/mechanisms/evm/batch_settlement/types.py",
      "python/x402/mechanisms/evm/batch_settlement/utils.py",
      "python/x402/schemas/hooks.py",
      "python/x402/server.py",
      "python/x402/server_base.py",
      "python/x402/tests/unit/mechanisms/evm/batch_settlement/client/test_managed_salt.py",
      "python/x402/tests/unit/mechanisms/evm/batch_settlement/server/test_managed.py",
      "python/x402/tests/unit/mechanisms/evm/batch_settlement/server/test_managed_recovery.py",
      "python/x402/tests/unit/mechanisms/evm/batch_settlement/test_types.py"
    ],
    "env": {
      "PYTHONPATH": "<implementation>/python",
      "PYTHONDONTWRITEBYTECODE": "1",
      "RUFF_NUM_THREADS": "2",
      "RAYON_NUM_THREADS": "2"
    },
    "exit": 0
  },
