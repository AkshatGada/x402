+            "maxClaimableAmount": "100",
+            "signature": "0x" + "11" * 65,
+        },
+    }
+    if kind == "deposit":
+        raw["deposit"] = {"amount": "1000", "authorization": {}}
+    if amount is not None:
+        raw["amount"] = amount
