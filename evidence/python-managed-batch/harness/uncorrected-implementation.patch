+
+class Signer:
+    address = REFUND_AUTHORIZER
+
+    def __init__(self):
+        self.signed = []
+
+    def sign_typed_data(self, **kwargs):
+        self.signed.append(kwargs)
+        return "0x" + "ab" * 65
+
+
+def scheme(**kwargs):
+    return BatchSettlementEvmScheme(
